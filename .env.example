# Copy this file to .env.local and fill in the values. Never commit .env.local.

# PayPal: developer.paypal.com -> Apps & Credentials (Sandbox) -> DisputeGuard
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Only "sandbox" is allowed in this project.
PAYPAL_ENV=sandbox

# Anthropic: console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
# Optional: override the model used by the agent.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Neon Postgres: console.neon.tech -> project -> Connect (pooled connection string)
DATABASE_URL=

# PayPal webhook ID (after deploying: developer.paypal.com -> DisputeGuard app -> Sandbox Webhooks -> Add Webhook,
# URL https://<your-app>/api/webhooks/paypal, events CUSTOMER.DISPUTE.*)
PAYPAL_WEBHOOK_ID=

# Optional: cap on AI investigations per hour (protects a public demo from runaway costs).
MAX_INVESTIGATIONS_PER_HOUR=30
